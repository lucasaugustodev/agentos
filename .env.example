# Public template. npm run setup replaces the two secret placeholders locally.
POSTGRES_PASSWORD=replace-with-a-new-random-value
DATABASE_URL=postgresql://agentos:replace-with-a-new-random-value@127.0.0.1:15482/agentos
AGENTOS_API_TOKEN=replace-with-a-new-random-value
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=4280
AGENTOS_ORIGIN=http://127.0.0.1:4280
AGENTOS_DATA_DIR=.local
AGENTOS_ROLE=all
AGENTOS_WORKER_SLOTS=16
AGENTOS_SCOPED_PLANNER_LIMIT=5
AGENTOS_REMOTE_EXECUTION=0
AGENTOS_BRIDGE_HOST=
AGENTOS_TAILNET_HOST=
AGENTOS_DSH_COMMAND=
AGENTOS_DSH_ARGS=[]
AGENTOS_LAYA_URL=
AGENTOS_RECALL_URL=
AGENTOS_RECALL_KEY=
AGENTOS_RECALL_NAMESPACE=agentos-development
# Seats are not provider requests. These size the local scheduler and the
# database pool; simultaneous GLM calls stay capped at six by the request gate.
AGENTOS_PG_POOL_MAX=15
AGENTOS_CAPACITY_MAX_RUNS=4
AGENTOS_BROWSER_SLOTS=2
AGENTOS_REMOTE_MAX_RUNS=2
AGENTOS_REMOTE_MEMORY_MIB=3600
AGENTOS_REMOTE_CPU_PERCENT=300
AGENTOS_ACCOUNT_MAX_CONCURRENCY=4
# Workers run inside bubblewrap namespaces under systemd. Set to 1 only on a
# development host without them: execution is then NOT isolated and is recorded
# as such in the run state.
AGENTOS_UNSANDBOXED_RUNTIME=0
# Bridge storage and workspace roots. Left empty, the bridge uses the
# provisioned paths when they exist and falls back to .local/ otherwise; both
# are canonicalized, because the path guards compare realpath.
AGENTOS_BRIDGE_DATA=
AGENTOS_WORKSPACES_ROOT=
AGENTOS_NODE_BIN=
# The six-request GLM ceiling lives in a gate process. A provisioned host runs
# it under systemd and the bridge joins its socket. Set to 1 only on a
# development host that has no gate: the bridge then owns one for itself.
AGENTOS_LOCAL_GLM_GATE=0
